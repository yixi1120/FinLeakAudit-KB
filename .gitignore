# Large binary files — keep in raw/papers/ for reference
# *.pdf  ← 保留 PDF 引用

# macOS
.DS_Store
.AppleDouble

# Python
__pycache__/
*.pyc
.venv/
venv/

# IDE
.vscode/
.idea/

# Local review and rendered artifacts
tmp/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/main.pdf
paper/figures/*.alignment.svg
paper/figures/*.collision-audit.pdf

# Model files (large)
*.gguf
*.bin
*.safetensors
*.pth
*.ckpt

# Results (generated, large)
experiments/results/*.jsonl
experiments/results/*.csv

# Keep blind annotation materials separate until adjudication.
experiments/analysis/semantic_annotation_key_*.csv
experiments/analysis/semantic_annotations_annotator_*.csv

# Keep the natural hard-set coordinator mapping private until test gold freezes.
experiments/analysis/natural_semantic_hard_key_*.csv
experiments/analysis/natural_semantic_hard_*_annotator_*.csv
experiments/analysis/natural_semantic_hard_*_adjudication*.csv

# The v1 coordinator key is publishable after the gold labels were frozen.
!experiments/analysis/semantic_annotation_key_v1.csv

# Secrets
.env
*.key
